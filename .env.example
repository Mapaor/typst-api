# Server port
PORT=8080

# Paths to search for fonts, separated by commas
TYPST_FONT_PATHS=./fonts

# Maximum payload size in bytes (default is 50MB)
MAX_PAYLOAD_SIZE=52428800

# Compilation timeout in seconds (default is 30s)
# Note: Most documents take less than 2s, but some cetz plots may take 20s or more.
COMPILATION_TIMEOUT=30

# Optional authentication token
# AUTH_TOKEN=my-secret-token
