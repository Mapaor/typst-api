# Server port
PORT=8080

# Paths to search for fonts, separated by commas
TYPST_FONT_PATHS=./fonts

# Maximum payload size in bytes (default is 50MB)
MAX_PAYLOAD_SIZE=52428800

# Compilation timeout in seconds (default is 30s)
# Note: Most documents take less than 2s, but some cetz plots may take 20s or more.
COMPILATION_TIMEOUT=30

# Maximum number of active compilations allowed concurrently.
# Useful to prevent the server from crashing if lots of people (>10) compile at the exact same time.
MAX_CONCURRENT_COMPILATIONS=10

# Optional authentication token
# AUTH_TOKEN=my-secret-token

# Optional admin authentication token (defaults to AUTH_TOKEN if left unset)
# Highly recommended if you want to share your API with friends but restrict some admin endpoints (like /admin/fonts/refresh).
# ADMIN_TOKEN=my-admin-secret-token

# Package Cache Management
# Optional: Preload specific packages on startup (comma-separated).
# Example: @preview/cetz:0.3.1,@preview/tablex:0.0.8
# PRELOAD_PACKAGES=

# Optional: Sync and download all packages from the Typst registry on startup in the background when the container starts (~1.5 GB).
# CACHE_ALL_PACKAGES=false

# CORS Allowed Origins
# If unset, CORS is disabled. If set to "*", it's permissive (all domains).
# Or specify a comma-separated list of domains (also specify the port if you want to restrict the other ports).
# Example: http://localhost:3000,http://example.com
# For local development use the wildcard, for production allow only trusted origins:
# CORS_ALLOWED_ORIGINS=*
